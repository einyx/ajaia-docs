{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ajaia Docs — a lightweight collaborative document editor (Cloudflare Workers + D1 + React + TipTap)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node src/server/local.ts",
    "serve": "node --experimental-strip-types src/server/standalone.ts",
    "build": "node scripts/publish-video.mjs && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev --port 8788",
    "package": "node scripts/package-submission.mjs",
    "test": "vitest run",
    "verify:pdf": "node scripts/verify-pdf-export.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ajaia --local",
    "db:migrate:remote": "wrangler d1 migrations apply ajaia --remote",
    "video:prepare": "node scripts/narrate.mjs --prepare",
    "video:record": "node scripts/walkthrough.mjs",
    "video:narrate": "node scripts/narrate.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.14",
    "mammoth": "^1.11.0",
    "marked": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.7",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
